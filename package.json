{
  "name": "saucedemo-e2e-tests",
  "version": "1.0.0",
  "description": "End-to-end test suite for SauceDemo using WebdriverIO and Cucumber.",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "wdio run ./wdio.conf.ts",
    "test:smoke": "wdio run ./wdio.conf.ts --cucumberOpts.tagExpression=@smoke",
    "test:regression": "wdio run ./wdio.conf.ts --cucumberOpts.tagExpression=@regression",
    "test:login": "wdio run ./wdio.conf.ts --cucumberOpts.tagExpression=@login",
    "test:inventory": "wdio run ./wdio.conf.ts --cucumberOpts.tagExpression=@inventory",
    "test:checkout": "wdio run ./wdio.conf.ts --cucumberOpts.tagExpression=@checkout",
    "test:cart": "wdio run ./wdio.conf.ts --cucumberOpts.tagExpression=@cart",
    "test:positive": "wdio run ./wdio.conf.ts --cucumberOpts.tagExpression=@positive",
    "test:negative": "wdio run ./wdio.conf.ts --cucumberOpts.tagExpression=@negative",
    "test:headless": "cross-env HEADLESS=true wdio run ./wdio.conf.ts",
    "test:tag": "wdio run ./wdio.conf.ts --cucumberOpts.tagExpression",
    "test:clean": "npm run clean:evidence && npm test",
    "clean": "node ./scripts/clean-evidence.ts",
    "clean:evidence": "node ./scripts/clean-evidence.ts",
    "clean:results": "node ./scripts/clean-evidence.ts --results-only",
    "clean:report": "node ./scripts/clean-evidence.ts --report-only",
    "clean:screenshots": "node ./scripts/clean-evidence.ts --screenshots-only",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report",
    "report:serve": "allure serve allure-results",
    "report": "npm run report:generate && npm run report:open",
    "test:report": "npm run clean:evidence && npm run test:smoke && npm run report:generate",
    "wdio": "wdio run ./wdio.conf.ts"
  },
  "keywords": [
    "webdriverio",
    "cucumber",
    "e2e",
    "saucedemo"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@wdio/allure-reporter": "^9.32.0",
    "@wdio/cli": "^9.32.0",
    "@wdio/cucumber-framework": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "allure-commandline": "^2.46.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.11.0",
    "expect-webdriverio": "^6.1.0",
    "typescript": "~5.7.3"
  }
}
