{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug WebdriverIO",
      "program": "${workspaceFolder}/node_modules/@wdio/cli/bin/wdio.js",
      "args": [
        "run",
        "${workspaceFolder}/wdio.conf.ts",
        "--spec",
        "${workspaceFolder}/features/checkout.feature"
      ],
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    }
  ]
}